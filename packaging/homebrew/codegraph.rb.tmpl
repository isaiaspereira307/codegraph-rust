# ABOUTME: Homebrew formula template for codegraph, rendered by scripts/release/render-formula.sh.
# ABOUTME: Placeholders @VERSION@ and @SHA_<TARGET>@ are replaced with release values.
class Codegraph < Formula
  desc "Code knowledge graph served to AI clients over MCP"
  homepage "https://github.com/isaiaspereira307/codegraph-rust"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/isaiaspereira307/codegraph-rust/releases/download/v@VERSION@/codegraph-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "https://github.com/isaiaspereira307/codegraph-rust/releases/download/v@VERSION@/codegraph-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/isaiaspereira307/codegraph-rust/releases/download/v@VERSION@/codegraph-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_AARCH64_UNKNOWN_LINUX_GNU@"
    end
    on_intel do
      url "https://github.com/isaiaspereira307/codegraph-rust/releases/download/v@VERSION@/codegraph-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_X86_64_UNKNOWN_LINUX_GNU@"
    end
  end

  def install
    bin.install "codegraph"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/codegraph --version")
  end
end
